# FEM15 on-antenna field response test.
# Precondition: Ant15 is approved out of service and an operator is watching.
# The test ends in a conservative manual/high-attenuation state.

DCMAUTO-OFF ANT15
DCMATTN 31 31 ANT15
FEMAUTO-OFF ANT15
ND-OFF ANT15
HATTN 31 31 ANT15
VATTN 31 31 ANT15
$WAIT 10

# ND OFF: sweep the first and second FEM attenuators.
HATTN 16 0 ANT15
VATTN 16 0 ANT15
$WAIT 10
HATTN 8 0 ANT15
VATTN 8 0 ANT15
$WAIT 10
HATTN 4 0 ANT15
VATTN 4 0 ANT15
$WAIT 10
HATTN 2 0 ANT15
VATTN 2 0 ANT15
$WAIT 10
HATTN 1 0 ANT15
VATTN 1 0 ANT15
$WAIT 10
HATTN 0 0 ANT15
VATTN 0 0 ANT15
$WAIT 10
HATTN 0 1 ANT15
VATTN 0 1 ANT15
$WAIT 10
HATTN 0 2 ANT15
VATTN 0 2 ANT15
$WAIT 10
HATTN 0 4 ANT15
VATTN 0 4 ANT15
$WAIT 10
HATTN 0 8 ANT15
VATTN 0 8 ANT15
$WAIT 10
HATTN 0 16 ANT15
VATTN 0 16 ANT15
$WAIT 10
HATTN 31 31 ANT15
VATTN 31 31 ANT15
$WAIT 10

# ND ON: repeat the same Ant15-only sweep.
ND-ON ANT15
$WAIT 10
HATTN 16 0 ANT15
VATTN 16 0 ANT15
$WAIT 10
HATTN 8 0 ANT15
VATTN 8 0 ANT15
$WAIT 10
HATTN 4 0 ANT15
VATTN 4 0 ANT15
$WAIT 10
HATTN 2 0 ANT15
VATTN 2 0 ANT15
$WAIT 10
HATTN 1 0 ANT15
VATTN 1 0 ANT15
$WAIT 10
HATTN 0 0 ANT15
VATTN 0 0 ANT15
$WAIT 10
HATTN 0 1 ANT15
VATTN 0 1 ANT15
$WAIT 10
HATTN 0 2 ANT15
VATTN 0 2 ANT15
$WAIT 10
HATTN 0 4 ANT15
VATTN 0 4 ANT15
$WAIT 10
HATTN 0 8 ANT15
VATTN 0 8 ANT15
$WAIT 10
HATTN 0 16 ANT15
VATTN 0 16 ANT15
$WAIT 10

# Conservative end state; restoration is a separate operator action.
ND-OFF ANT15
HATTN 31 31 ANT15
VATTN 31 31 ANT15
DCMATTN 31 31 ANT15
$WAIT 10
